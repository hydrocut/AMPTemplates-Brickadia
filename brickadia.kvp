Meta.DisplayName=Brickadia (TeamKit)
Meta.Description=Serveur dedie officiel de Brickadia (construction en briques multijoueur, acces anticipe) : telecharge anonymement par SteamCMD (app 3017590), mais un jeton d'hebergement cree sur brickadia.com avec un compte qui possede le jeu est obligatoire. Un seul port, 7777 en UDP. Monde cree au premier demarrage puis recharge, sauvegarde a chaque arret. Reglages en francais (nom, description, message d'accueil, mot de passe, liste publique, sauvegarde automatique). Arrivees et departs des joueurs visibles dans AMP, console d'AMP branchee sur le serveur.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-Brickadia
Meta.DisplayImageSource=steam:2199420
Meta.EndpointURIFormat=
Meta.ConfigManifest=brickadiaconfig.json
Meta.MetaConfigManifest=brickadiametaconfig.json
Meta.ConfigRoot=brickadia.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Le script de lancement est en Python 3 et utilise stdbuf (coreutils) : ExtraContainerPackages garantit python3 dans le conteneur Debian 13.
Meta.ExtraSetupStepsURI=https://brickadia.com/account/tokens
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["python3"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=ae456a8e-2f5d-40f6-84d2-6541451b6a69
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
